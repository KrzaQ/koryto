# Copy to .env (gitignored) and fill in. docker-compose.yml reads it.

# Password for the postgres sidecar; KORYTO_DATABASE_URL is derived from it.
POSTGRES_PASSWORD=change-me

# Public origin. The OIDC redirect URI is derived from it, never from headers.
KORYTO_PUBLIC_URL=https://koryto.int.krzaq.cc

# At least 32 bytes; signs and encrypts the session cookie.
# openssl rand -base64 48
KORYTO_SECRET=

# authentik: create an OAuth2/OpenID provider (authorization code,
# confidential, redirect URI ${KORYTO_PUBLIC_URL}/api/auth/callback) and an
# application bound to it; the issuer is the application's slug URL.
KORYTO_AUTH=oidc
KORYTO_OIDC_ISSUER=https://authentik.krzaq.cc/application/o/koryto/
KORYTO_OIDC_CLIENT_ID=
KORYTO_OIDC_CLIENT_SECRET=
# Optional: only members of this authentik group may log in. Leave it unset
# to let any authentik account in; nobody sees data until the CLI has placed
# them in a household, and an application policy in authentik can gate the
# login there instead.
# KORYTO_OIDC_GROUP=koryto

# Optional: skip migrations at startup.
# KORYTO_AUTO_MIGRATE=0
# Optional: log filter.
RUST_LOG=info
