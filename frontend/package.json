{
  "name": "koryto-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "vue-tsc -b",
    "types": "openapi-typescript http://127.0.0.1:8000/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^3.0.0",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.2.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true
  }
}
